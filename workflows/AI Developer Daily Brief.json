        "messages": {
          "values": [
            {
              "content": "=You are an AI Developer News Analyst.\n\nCreate a concise AI Developer Daily Brief from the stories provided below.\n\nSelect only stories relevant to:\nAI, machine learning, software development, programming, developer tools, open source, cybersecurity, cloud, infrastructure, or interesting technical projects.\n\nUse this exact format:\n\nAI DEVELOPER DAILY BRIEF\n\n1. TITLE\nSummary: one or two sentences.\nWhy developers should care: one sentence.\nURL: https://example.com\n\n2. TITLE\nSummary: one or two sentences.\nWhy developers should care: one sentence.\nURL: https://example.com\n\n3. TITLE\nSummary: one or two sentences.\nWhy developers should care: one sentence.\nURL: https://example.com\n\n4. TITLE\nSummary: one or two sentences.\nWhy developers should care: one sentence.\nURL: https://example.com\n\nThen:\n\nTOP 3 TAKEAWAYS\n\n1. One takeaway.\n2. One takeaway.\n3. One takeaway.\n\nIMPORTANT:\nReturn PLAIN TEXT ONLY.\nDo NOT use Markdown.\nDo NOT use # symbols.\nDo NOT use * symbols.\nDo NOT use [ ] or ( ) for links.\nDo NOT write escaped characters such as \\n.\nDo NOT put URLs inside Markdown links.\nWrite each section on separate lines.\n\nStories:\n\n{{$json.stories}}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
