    {
      "parameters": {
        "jsCode": "const stories = $input.all();\n\nconst text = stories.map((item, index) => {\n  return `${index + 1}. ${item.json.title}\nScore: ${item.json.score}\nURL: ${item.json.url}`;\n}).join('\\n\\n');\n\nreturn [\n  {\n    json: {\n      stories: text\n    }\n  }\n];"
      },
