      "name": "Message a model",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "credentials": {
        "googlePalmApi": {
          "id": "needlD2Wg9TaT2Xd",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nlet text = input.brief || input.text || input.message || '';\n\nif (!text && input.content?.parts?.[0]?.text) {\n  text = input.content.parts[0].text;\n}\n\ntext = String(text);\n\n// Convert literal backslash+n into real new lines\ntext = text.split('\\\\n').join('\\n');\n\n// Remove markdown bold\ntext = text.split('**').join('');\n\nreturn [\n  {\n    json: {\n      message: text.trim()\n    }\n  }\n];"
      },
